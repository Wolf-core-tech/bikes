rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validAnnouncement(data) {
      return data.keys().hasOnly([
          'title', 'description', 'category', 'creatorUserId',
          'creatorDisplayName', 'createdAt', 'updatedAt',
          'eventDateTime', 'eventLocalDateTime', 'timeZone',
          'meetingPlace', 'meetingAddress', 'latitude', 'longitude',
          'additionalInstructions', 'rsvpDeadline',
          'rsvpDeadlineLocalDateTime', 'status', 'publishedAt',
          'isPublished', 'cancellationMessage'
        ]) &&
        data.title is string && data.title.size() <= 100 &&
        data.description is string && data.description.size() <= 5000 &&
        data.category in [
          'ride', 'meetup', 'community_news', 'important_update', 'emergency'
        ] &&
        data.creatorUserId is string &&
        data.creatorDisplayName is string &&
        data.creatorDisplayName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.timeZone is string && data.timeZone.size() <= 100 &&
        data.isPublished is bool &&
        data.status in ['draft', 'published', 'cancelled', 'completed'] &&
        (data.eventDateTime == null || data.eventDateTime is timestamp) &&
        (data.eventLocalDateTime == null ||
          (data.eventLocalDateTime is string && data.eventLocalDateTime.size() <= 32)) &&
        (data.meetingPlace == null ||
          (data.meetingPlace is string && data.meetingPlace.size() <= 150)) &&
        (data.meetingAddress == null ||
          (data.meetingAddress is string && data.meetingAddress.size() <= 300)) &&
        (data.latitude == null ||
          (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (data.longitude == null ||
          (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        (data.additionalInstructions == null ||
          (data.additionalInstructions is string &&
            data.additionalInstructions.size() <= 2000)) &&
        (data.rsvpDeadline == null || data.rsvpDeadline is timestamp) &&
        (data.rsvpDeadlineLocalDateTime == null ||
          (data.rsvpDeadlineLocalDateTime is string &&
            data.rsvpDeadlineLocalDateTime.size() <= 32)) &&
        (data.isPublished && data.category in ['ride', 'meetup']
          ? data.eventDateTime is timestamp &&
            data.eventLocalDateTime is string &&
            data.meetingPlace is string &&
            data.meetingPlace.size() > 0
          : true) &&
        (data.publishedAt == null || data.publishedAt is timestamp) &&
        (data.cancellationMessage == null ||
          (data.cancellationMessage is string &&
            data.cancellationMessage.size() <= 300)) &&
        (data.eventDateTime == null || data.rsvpDeadline == null ||
          data.rsvpDeadline < data.eventDateTime) &&
        (data.isPublished
          ? data.publishedAt is timestamp && data.status in ['published', 'cancelled', 'completed']
          : data.publishedAt == null && data.status == 'draft');
    }

    function isFriend(otherUserId) {
      let first = request.auth.uid < otherUserId ? request.auth.uid : otherUserId;
      let second = request.auth.uid < otherUserId ? otherUserId : request.auth.uid;
      return exists(/databases/$(database)/documents/friendships/$(first + '_' + second));
    }

    function isSquadMember(squadId) {
      return signedIn() && exists(
        /databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid)
      );
    }

    function isSquadLeader(squadId) {
      return signedIn() && (
        get(/databases/$(database)/documents/squads/$(squadId)).data.ownerId == request.auth.uid ||
        (isSquadMember(squadId) &&
          get(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid)).data.role in ['leader', 'coLeader'])
      );
    }

    function canReadConversation(conversation) {
      return signedIn() && (
        (conversation.data.kind == 'direct' &&
          request.auth.uid in conversation.data.participants &&
          conversation.data.participants.size() == 2 &&
          isFriend(conversation.data.participants[0] == request.auth.uid
            ? conversation.data.participants[1]
            : conversation.data.participants[0])) ||
        (conversation.data.kind == 'squad' && isSquadMember(conversation.data.squadId))
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      function validUserFields() {
        return request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'photoUrl', 'photoPath',
          'bikeStatus', 'bikeBrand', 'bikeModel', 'bikeCc',
          'bikeVehicleType', 'bikeYear', 'bikeRegistration', 'createdAt',
          'isOnline', 'lastSeen', 'fcmToken', 'announcementNotificationsEnabled',
          'notificationsEnabled', 'notificationSoundEnabled',
          'notificationVibrationEnabled', 'customNotificationsEnabled'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 32 &&
        (!('photoPath' in request.resource.data) ||
          request.resource.data.photoPath == null ||
          request.resource.data.photoPath.matches('^profile_photos/' + userId + '/[0-9]+_[0-9]+[.]jpg$')) &&
        (!('fcmToken' in request.resource.data) ||
          (request.resource.data.fcmToken is string &&
            request.resource.data.fcmToken.size() <= 4096)) &&
        (!('isOnline' in request.resource.data) ||
          request.resource.data.isOnline is bool) &&
        (!('announcementNotificationsEnabled' in request.resource.data) ||
          request.resource.data.announcementNotificationsEnabled is bool) &&
        (!('notificationsEnabled' in request.resource.data) ||
          request.resource.data.notificationsEnabled is bool) &&
        (!('notificationSoundEnabled' in request.resource.data) ||
          request.resource.data.notificationSoundEnabled is bool) &&
        (!('notificationVibrationEnabled' in request.resource.data) ||
          request.resource.data.notificationVibrationEnabled is bool) &&
        (!('customNotificationsEnabled' in request.resource.data) ||
          request.resource.data.customNotificationsEnabled is bool);
      }

      allow create: if signedIn() && request.auth.uid == userId &&
        validUserFields();
      allow update: if signedIn() && request.auth.uid == userId &&
        validUserFields();
      allow delete: if false;

      match /notifications/{notificationId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.recipientUserId == userId &&
          request.resource.data.notificationId == notificationId &&
          request.resource.data.type == 'destination_reached' &&
          request.resource.data.isRead == false &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.title == 'Destination reached!' &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 200 &&
          request.resource.data.senderUserId == null &&
          request.resource.data.relatedRideId is string &&
          request.resource.data.relatedRideId.size() <= 100 &&
          notificationId == 'destination_' + request.resource.data.relatedRideId &&
          request.resource.data.keys().hasOnly([
            'notificationId', 'recipientUserId', 'senderUserId', 'type',
            'title', 'body', 'createdAt', 'isRead', 'relatedRideId'
          ]);
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead == true;
        allow delete: if false;
      }

      match /squads/{squadId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId &&
          existsAfter(/databases/$(database)/documents/squads/$(squadId)/members/$(userId));
        allow delete: if signedIn() &&
          (request.auth.uid == userId ||
            get(/databases/$(database)/documents/squads/$(squadId)).data.ownerId == request.auth.uid);
        allow update: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /friendPresence/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isFriend(userId));
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /securityRateLimits/{userId} {
      allow read, write: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if signedIn() &&
        (resource.data.isPublished == true ||
          resource.data.creatorUserId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.creatorUserId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (request.resource.data.isPublished
          ? request.resource.data.publishedAt == request.time &&
            (request.resource.data.category in ['ride', 'meetup']
              ? request.resource.data.eventDateTime > request.time
              : true)
          : request.resource.data.publishedAt == null) &&
        validAnnouncement(request.resource.data);
      allow update: if signedIn() &&
        resource.data.creatorUserId == request.auth.uid &&
        request.resource.data.creatorUserId == resource.data.creatorUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'category', 'creatorDisplayName',
          'updatedAt', 'eventDateTime', 'eventLocalDateTime', 'timeZone',
          'meetingPlace', 'meetingAddress', 'latitude', 'longitude',
          'additionalInstructions', 'rsvpDeadline',
          'rsvpDeadlineLocalDateTime', 'status', 'publishedAt',
          'isPublished', 'cancellationMessage'
        ]) &&
        (resource.data.isPublished
          ? request.resource.data.publishedAt == resource.data.publishedAt &&
            request.resource.data.isPublished == true
          : (request.resource.data.isPublished == false ||
              (request.resource.data.isPublished == true &&
                request.resource.data.publishedAt == request.time &&
                (request.resource.data.category in ['ride', 'meetup']
                  ? request.resource.data.eventDateTime > request.time
                  : true)))) &&
        validAnnouncement(request.resource.data);
      allow delete: if signedIn() &&
        resource.data.creatorUserId == request.auth.uid &&
        resource.data.isPublished == false;

      match /responses/{userId} {
        function canRespond() {
          let announcement = get(
            /databases/$(database)/documents/announcements/$(announcementId)
          ).data;
          return signedIn() &&
            announcement.isPublished == true &&
            announcement.status == 'published' &&
            announcement.category in ['ride', 'meetup'] &&
            (announcement.rsvpDeadline == null ||
              announcement.rsvpDeadline > request.time);
        }

        function validResponse() {
          let profile = get(
            /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
          ).data;
          return request.resource.data.keys().hasOnly([
              'userId', 'displayName', 'photoPath', 'response',
              'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.displayName == profile.name &&
            request.resource.data.photoPath == profile.photoPath &&
            request.resource.data.response in ['coming', 'not_coming', 'unsure'] &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.updatedAt == request.time;
        }

        allow get: if signedIn() &&
          (request.auth.uid == userId ||
            (signedIn() &&
              get(/databases/$(database)/documents/announcements/$(announcementId)).data.creatorUserId == request.auth.uid));
        allow list: if signedIn() &&
          get(/databases/$(database)/documents/announcements/$(announcementId)).data.creatorUserId == request.auth.uid;
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          canRespond() &&
          request.resource.data.createdAt == request.time &&
          validResponse();
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          canRespond() &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'response', 'updatedAt'
          ]) &&
          validResponse();
        allow delete: if false;
      }
    }

    match /announcementDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /users/{userId}/announcementReads/{announcementId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'announcementId', 'userId', 'viewedAt'
        ]) &&
        request.resource.data.announcementId == announcementId &&
        request.resource.data.userId == userId &&
        request.resource.data.viewedAt == request.time &&
        get(/databases/$(database)/documents/announcements/$(announcementId)).data.isPublished == true;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          (resource.data.receiverEmail is string &&
            resource.data.receiverEmail == request.auth.token.email));
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.senderId != request.resource.data.receiverId;
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid &&
        resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId;
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 2 && request.resource.data.accepted == true &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted' &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.members &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.receiverId in request.resource.data.members;
      allow update, delete: if false;
    }

    match /squadInvitations/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid &&
        get(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.status == 'active' &&
        request.resource.data.status == 'used' && request.resource.data.claimedBy == request.auth.uid &&
        resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.squadId == resource.data.squadId &&
        request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if false;
    }

    match /squadJoinRequests/{requestId} {
      allow get, list: if signedIn() &&
        (resource.data.requesterId == request.auth.uid ||
          isSquadLeader(resource.data.squadId));
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.squadId is string &&
        request.resource.data.squadName is string &&
        request.resource.data.squadName.size() <= 100 &&
        request.resource.data.requesterName is string &&
        request.resource.data.requesterName.size() <= 100 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        requestId == request.resource.data.squadId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/squads/$(request.resource.data.squadId)) &&
        get(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.kind == 'squad' &&
        request.resource.data.keys().hasOnly([
          'squadId', 'squadName', 'requesterId', 'requesterName',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        !exists(/databases/$(database)/documents/squads/$(request.resource.data.squadId)/members/$(request.auth.uid));
      allow update: if signedIn() &&
        isSquadLeader(resource.data.squadId) &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedBy'
        ]);
      allow delete: if false;
    }

    match /squads/{squadId} {
      allow get: if signedIn() && isSquadMember(squadId);
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'kind', 'ownerId', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.kind in ['solo', 'duo', 'squad'];
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'kind']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.kind in ['solo', 'duo', 'squad'];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if signedIn() && isSquadMember(squadId);
        allow create: if signedIn() &&
          (isSquadLeader(squadId) ||
            (request.auth.uid == memberId &&
              request.resource.data.invitationCode is string &&
              getAfter(/databases/$(database)/documents/squadInvitations/$(request.resource.data.invitationCode)).data.status == 'used' &&
              getAfter(/databases/$(database)/documents/squadInvitations/$(request.resource.data.invitationCode)).data.claimedBy == request.auth.uid &&
              getAfter(/databases/$(database)/documents/squadInvitations/$(request.resource.data.invitationCode)).data.expiresAt > request.time &&
              getAfter(/databases/$(database)/documents/squadInvitations/$(request.resource.data.invitationCode)).data.squadId == squadId));
        allow delete: if signedIn() &&
          (request.auth.uid == memberId ||
            get(/databases/$(database)/documents/squads/$(squadId)).data.ownerId == request.auth.uid);
        allow update: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
          canReadConversation(resource));
      allow create: if signedIn() && (
        (request.resource.data.kind == 'direct' &&
          request.resource.data.participants.size() == 2 &&
          request.auth.uid in request.resource.data.participants &&
          isFriend(request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0])) ||
        (request.resource.data.kind == 'squad' &&
          isSquadMember(request.resource.data.squadId))
      );
      allow update: if canReadConversation(resource) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'unreadCounts']) ||
          (resource.data.kind == 'squad' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'unreadCounts']) &&
            (request.auth.uid in request.resource.data.participants ||
              (!existsAfter(/databases/$(database)/documents/squads/$(resource.data.squadId)/members/$(request.auth.uid)) &&
                exists(/databases/$(database)/documents/squads/$(resource.data.squadId)/members/$(request.auth.uid))))));
      allow delete: if signedIn() && resource.data.kind == 'squad' &&
        get(/databases/$(database)/documents/squads/$(resource.data.squadId)).data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if canReadConversation(
          get(/databases/$(database)/documents/conversations/$(conversationId))
        );
        allow create: if canReadConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId))
          ) && request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.readBy == [request.auth.uid];
        allow update: if canReadConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId))
          ) && !(request.auth.uid in resource.data.readBy) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.hasAll(resource.data.readBy) &&
          request.resource.data.readBy.size() == resource.data.readBy.size() + 1 &&
          request.auth.uid in request.resource.data.readBy;
        allow delete: if false;
      }
    }
  }
}
